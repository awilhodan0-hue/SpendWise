
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

:root {
    --primary: #15803d;
    --secondary: #166534;
    --background: #f0fdf4;
    --white: #ffffff;
    --text: #1f2937;
    --border: #d1d5db;
    --danger: #dc2626;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Poppins', sans-serif;
    background: var(--background);
    color: var(--text);
}

header {
    background: var(--primary);
    color: white;
    text-align: center;
    padding: 30px 15px;
}

header h1 {
    font-size: 32px;
}

.container {
    max-width: 1100px;
    margin: 30px auto;
    padding: 20px;
}

.summary {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: var(--white);
    padding: 25px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

.card h3 {
    color: var(--secondary);
    margin-bottom: 10px;
}

.card p {
    font-size: 23px;
    font-weight: 700;
}

.form-section,
.expenses-section {
    background: var(--white);
    margin-top: 30px;
    padding: 25px;
    border-radius: 12px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.08);
}

h2 {
    color: var(--primary);
    margin-bottom: 20px;
}

form {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
}

input,
select {
    width: 100%;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: inherit;
}

button {
    background: var(--primary);
    color: white;
    padding: 12px 18px;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-family: inherit;
}

button:hover {
    background: var(--secondary);
}

table {
    width: 100%;
    border-collapse: collapse;
}

th,
td {
    padding: 14px;
    text-align: left;
    border-bottom: 1px solid var(--border);
}

th {
    background: var(--primary);
    color: white;
}

.delete-btn {
    background: var(--danger);
}

#message {
    margin-top: 15px;
    font-weight: 500;
}

.table-container {
    overflow-x: auto;
}

footer {
    text-align: center;
    padding: 25px;
    background: var(--secondary);
    color: white;
    margin-top: 40px;
}

@media (max-width: 700px) {
    .summary {
        grid-template-columns: 1fr;
    }

    form {
        grid-template-columns: 1fr;
    }

    .container {
        padding: 12px;
    }
}
